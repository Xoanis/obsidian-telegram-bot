{
	"name": "obsidian-telegram-bot-plugin",
	"version": "1.0.0",
	"description": "Telegram transport plugin for Obsidian and PARA-integrated workflows.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"check": "tsc -noEmit -skipLibCheck",
		"build": "npm run check && node esbuild.config.mjs production",
		"test": "node tests/run-tests.mjs",
		"release:check": "node scripts/validate-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@grammyjs/files": "^1.1.1",
		"grammy": "^1.36.3",
		"obsidian-para-suite-contracts": "github:Xoanis/obsidian-para-suite-contracts#v0.1.0"
	}
}
